# Nginx site for the CI/CD Reliability AI Agent frontend.
# Rendered at container start by the nginx image's envsubst step (/etc/nginx/templates).
#   BACKEND_URL            Backend base URL, e.g. http://hackathon-ai-agent.<namespace>.svc.cluster.local:8080
#                          (a fully qualified name: nginx's resolver does not apply DNS search domains).
#   NGINX_LOCAL_RESOLVERS  Filled from /etc/resolv.conf by the image (NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1).
#
# The SPA is served from the root (/). Requests for the backend under /agent are proxied with the
# /agent prefix stripped, mirroring the Ingress rewrite the backend already expects (see its springdoc settings).

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Relative Location headers: correct behind any Ingress host, IP or TLS terminator.
    absolute_redirect off;
    server_tokens off;

    # Resolve BACKEND_URL per request so nginx starts even before the backend Service exists.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=30s ipv6=off;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 'ok';
    }

    # Backend: REST API, Actuator and OpenAPI docs.
    location ~ ^/agent/(api|actuator|v3/api-docs|swagger-ui)(/|\.html|$) {
        set $backend "${BACKEND_URL}";
        rewrite ^/agent/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /agent;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }

    # Content-hashed build output (main.<hash>.js, styles.<hash>.css, ...) never changes.
    location ~* ^/.+\.[0-9a-f]{16,}\.(js|css|woff2?|ttf|eot|svg|png|jpg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        try_files $uri =404;
    }

    # The shell must always be revalidated so new deployments are picked up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
    }

    # Angular routes: unknown paths fall back to index.html so deep links and refreshes work.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
